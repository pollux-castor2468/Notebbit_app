{
  "expo": {
    "name": "Notebbit",
    "slug": "fin_20_Notebbit",
    "version": "2.0.0",
    "scheme": "notebbit",
    "orientation": "portrait",
    "icon": "./assets/img/1.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/img/1.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFF9"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.notebbit.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/1.png",
        "backgroundColor": "#FFFFF9"
      }
    },
    "web": {
      "favicon": "./assets/img/1.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "366777a6-36aa-431b-9391-0b3ae9839bdf"
      }
    },
    "runtimeVersion": "1.0.0"
  }
}
